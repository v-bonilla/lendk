SHELL := /bin/sh
BATS := test/lib/bats-core/bin/bats
SHELLCHECK := uvx --from shellcheck-py==0.11.0.1 shellcheck
PREFIX := $(HOME)/.local
LENDK_MARKER := \# lendk: give API keys stored in pass to the commands that need them.
MARKER := \# lendk shim v1: generated by lendk sync, edits are overwritten
DOCKER_RUN := docker run --rm -u 1000:1000 -e HOME=/tmp -v "$(CURDIR):/src:ro" -w /src
# Rust: on Linux, the static musl target of the host's architecture, so one build runs on a glibc
# host, in the Ubuntu image and in the busybox image alike.
TOOLS := .tools
CARGO_DENY_VERSION := 0.20.2
CARGO_VET_VERSION := 0.10.2
RUST_TARGET = $(shell if [ "$$(uname -s)" = Linux ]; then echo "$$(uname -m)-unknown-linux-musl"; else rustc -vV | sed -n 's/^host: //p'; fi)
RUST_FLAGS = $(if $(findstring musl,$(RUST_TARGET)),-C linker=rust-lld -C link-self-contained=yes -C target-feature=+crt-static) \
	--remap-path-scope=all --remap-path-prefix=$${CARGO_HOME:-$$HOME/.cargo}=/cargo \
	--remap-path-prefix=$${RUSTUP_HOME:-$$HOME/.rustup}=/rustup --remap-path-prefix=$(CURDIR)=/src
CARGO = RUSTFLAGS="$(RUST_FLAGS)" cargo
RUST_BIN = $(CURDIR)/target/$(RUST_TARGET)/release/lendk
PORT_TAGS := !docker,!port:retire,!port:rework,!port:unit

.PHONY: deps lint test check check-docker images bench install uninstall prefix dist build test-port

deps:
	git submodule update --init
	cargo fetch --locked
	$(SHELLCHECK) --version >/dev/null
	cargo install --locked --root $(TOOLS) cargo-deny@=$(CARGO_DENY_VERSION)
	cargo install --locked --root $(TOOLS) cargo-vet@=$(CARGO_VET_VERSION)

lint:
	UV_OFFLINE=1 $(SHELLCHECK) bin/lendk install.sh test/*.bats $$(find test -name '*.bash' -not -path 'test/lib/*') $$(grep -l '^#!' test/fixtures/*)
	bash test/lint-repo.bash
	cargo fmt --check
	$(CARGO) clippy --locked --offline --release --target $(RUST_TARGET) --all-targets -- -D warnings

build:
	$(CARGO) build --locked --offline --release --target $(RUST_TARGET)

test: build
	@test -x $(BATS) || { echo 'bats-core is missing; run: make deps' >&2; exit 1; }
	$(CARGO) test --locked --offline --release --target $(RUST_TARGET)
	$(BATS) --filter-tags '!docker' test/*.bats

# The port's selection against the release binary; it fails for each verb not yet ported.
test-port: build
	@test -x $(BATS) || { echo 'bats-core is missing; run: make deps' >&2; exit 1; }
	LENDK=$(RUST_BIN) $(BATS) --filter-tags '$(PORT_TAGS)' test/*.bats

check: lint test
	# -D warnings: a build script that no longer matches its SHA-256 pin is only a warning.
	$(TOOLS)/bin/cargo-deny --frozen check -D warnings bans licenses sources
	PATH="$(CURDIR)/$(TOOLS)/bin:$$PATH" cargo vet --locked --frozen

images:
	docker pull -q bash:3.2.57 >/dev/null
	docker pull -q bash:4.3.48 >/dev/null
	docker build -q -t lendk-test:ubuntu -f test/docker/ubuntu.Dockerfile test/docker
	docker build -q -t lendk-test:bash44 -f test/docker/bash44.Dockerfile test/docker

check-docker: images
	@test -x $(BATS) || { echo 'bats-core is missing; run: make deps' >&2; exit 1; }
	$(BATS) --filter-tags docker test/*.bats
	$(DOCKER_RUN) --cap-add SYS_PTRACE \
		-e TEST_REQUIRE="gpg pass zsh strace script python3 git make environment-d" \
		lendk-test:ubuntu $(BATS) --filter-tags '!docker' test/*.bats
	$(DOCKER_RUN) -e TEST_REQUIRE=script lendk-test:bash44 $(BATS) --filter-tags '!docker' test/*.bats

bench:
	bash test/bench/bench.bash

prefix:
	@case '$(PREFIX)' in /*) ;; *) echo 'PREFIX must be an absolute path, for example PREFIX="$$HOME/.local"' >&2; exit 2 ;; esac

# A rename, never a rewrite: a running lendk keeps reading its old file.
install: prefix
	mkdir -p '$(DESTDIR)$(PREFIX)/bin'
	tmp=$$(mktemp '$(DESTDIR)$(PREFIX)/bin/.lendk.XXXXXX') && \
		{ cp bin/lendk "$$tmp" && chmod 755 "$$tmp" && mv -f "$$tmp" '$(DESTDIR)$(PREFIX)/bin/lendk' || { rm -f "$$tmp"; exit 1; }; }

uninstall: prefix
	@shims=$${LENDK_SHIMS-}; data=; \
	if [ -z "$$shims" ]; then \
		case $${XDG_DATA_HOME-} in /*) data=$$XDG_DATA_HOME/lendk ;; *) data=$$HOME/.local/share/lendk ;; esac; \
		shims=$$data/shims; \
	fi; \
	for f in "$$shims"/*; do \
		[ -f "$$f" ] && [ "$$(sed -n 2p "$$f")" = '$(MARKER)' ] && rm -f "$$f"; \
	done; \
	rmdir "$$shims" 2>/dev/null; \
	[ -z "$$data" ] || rmdir "$$data" 2>/dev/null; \
	bin='$(DESTDIR)$(PREFIX)/bin/lendk'; \
	if [ -f "$$bin" ] && [ ! -L "$$bin" ] && [ "$$(sed -n 2p "$$bin")" = '$(LENDK_MARKER)' ]; then \
		rm -f "$$bin"; \
	elif [ -e "$$bin" ] || [ -L "$$bin" ]; then \
		echo "$$bin is not a file make install wrote, so it stays" >&2; exit 1; \
	fi; \
	exit 0

# The release assets: the git tree at HEAD under lendk-X.Y.Z/, and its checksum.
dist:
	@v=$$(sed -n 's/^LENDK_VERSION=//p' bin/lendk); \
	mkdir -p dist && \
	git archive --format=tar.gz --prefix="lendk-$$v/" -o dist/lendk.tar.gz HEAD && \
	cd dist && \
	if command -v sha256sum >/dev/null; then sha256sum lendk.tar.gz; else shasum -a 256 lendk.tar.gz; fi >SHA256SUMS && \
	echo "built dist/lendk.tar.gz (lendk-$$v/) and dist/SHA256SUMS"
