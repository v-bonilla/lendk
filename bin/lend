#!/usr/bin/env bash
# lend: give API keys stored in pass to the commands that need them.
# SPDX-License-Identifier: MIT

# These lines must parse and run in bash 3.2 and any POSIX sh.
lend_old=
if [ -z "${BASH_VERSION-}" ]; then
	lend_old=unknown
elif [ "${BASH_VERSINFO[0]}" -lt 4 ] || { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 4 ]; }; then
	lend_old="${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]}.${BASH_VERSINFO[2]}"
fi
if [ -n "$lend_old" ]; then
	lend_fix='Stop and ask the user.'
	case "${LEND_PROMPT-auto}" in
	allow) lend_fix='Put a newer bash first on PATH.' ;;
	auto) if [ -t 0 ] || [ -t 2 ]; then lend_fix='Put a newer bash first on PATH.'; fi ;;
	esac
	printf 'lend: unsupported: bash %s found; lend needs bash 4.4 or later. %s\n' "$lend_old" "$lend_fix" >&2
	exit 125
fi
unset lend_old

LEND_VERSION=0.0.0

usage() {
	printf 'usage: lend --help | --version\n'
}

main() {
	case "${1-}" in
	--version) printf 'lend %s\n' "$LEND_VERSION" ;;
	--help) usage ;;
	*)
		printf 'lend: usage: %s. See: lend --help\n' "unknown arguments" >&2
		return 2
		;;
	esac
}

main "$@"; exit $?
